{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinderp/dna/schemas/v0.1/transport-policy.schema.json",
  "title": "TransportPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "requiredFeatures", "maximumPayloadBytes", "maximumEnergyCost", "maximumMonetaryCost", "maximumPrivacyExposure", "urgency", "expiresAt", "fallbackAllowed", "consentRef"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "requiredFeatures": { "$ref": "transport-capabilities.schema.json#/$defs/featureList" },
    "preferredTransports": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "uniqueItems": true },
    "forbiddenTransports": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "uniqueItems": true },
    "maximumPayloadBytes": { "type": "integer", "minimum": 1 },
    "maximumEnergyCost": { "enum": ["very_low", "low", "medium", "high"] },
    "maximumMonetaryCost": { "enum": ["free", "low", "metered", "high"] },
    "maximumPrivacyExposure": { "enum": ["low", "medium", "high"] },
    "urgency": { "enum": ["background", "normal", "urgent", "emergency"] },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "backoffMillis": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "fallbackAllowed": { "type": "boolean" },
    "consentRef": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
