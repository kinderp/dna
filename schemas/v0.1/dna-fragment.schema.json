{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinderp/dna/schemas/v0.1/dna-fragment.schema.json",
  "title": "DNAFragment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fragmentId", "subjectEphemeralId", "purpose", "claims", "audience", "issuedAt", "expiresAt", "revocable"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "fragmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subjectEphemeralId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": true
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["peer", "group", "service", "public_aggregate"] },
        "ids": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 128 }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revocable": { "type": "boolean" },
    "consentRef": { "type": "string", "maxLength": 256 },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
