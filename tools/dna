#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
COMMAND=${1:-help}
EXPECTED_TRAVEL_SHA=85c73ab78dd56506c5595673098adf514765de9c

require_travel() {
  if [ ! -f "$ROOT/domains/travel/tools/tdna" ]; then
    echo "Travel submodule is missing. Run: git submodule update --init --recursive" >&2
    exit 2
  fi
}

travel_recorded_sha() {
  git -C "$ROOT" ls-files --stage -- domains/travel | awk '$1 == "160000" {print $2}'
}

travel_checked_out_sha() {
  git -C "$ROOT/domains/travel" rev-parse HEAD
}

check_travel_revision() {
  require_travel
  recorded=$(travel_recorded_sha)
  checked_out=$(travel_checked_out_sha)

  if [ -z "$recorded" ]; then
    echo "Travel gitlink is not recorded in the current DNA index" >&2
    exit 1
  fi

  if [ "$recorded" != "$EXPECTED_TRAVEL_SHA" ]; then
    echo "Travel gitlink mismatch:" >&2
    echo "  expected:  $EXPECTED_TRAVEL_SHA" >&2
    echo "  recorded:  $recorded" >&2
    exit 1
  fi

  if [ "$checked_out" != "$recorded" ]; then
    echo "Travel checkout mismatch:" >&2
    echo "  recorded:    $recorded" >&2
    echo "  checked out: $checked_out" >&2
    echo "Run: git submodule update --init --recursive" >&2
    exit 1
  fi

  echo "PASS Travel revision: $checked_out"
}

case "$COMMAND" in
  help)
    cat <<'EOF'
usage: sh tools/dna COMMAND

commands:
  doctor                  show local tool and submodule state
  check-ci-actions        validate immutable GitHub Action pins
  check-core-contracts    validate DNA JSON schemas and examples
  check-core-reference    compile and test the Kotlin reference implementation
  check-travel-revision   verify the recorded and checked-out TDNA commit
  check-travel            run the TDNA non-emulator verification suite
  check-travel-emulator   run the isolated Android emulator verification
  check                   run all non-emulator DNA and Travel checks
EOF
    ;;
  doctor)
    python3 --version
    java -version
    git --version
    git -C "$ROOT" submodule status --recursive || true
    if [ -f "$ROOT/domains/travel/tools/tdna" ]; then
      echo "Travel expected:    $EXPECTED_TRAVEL_SHA"
      echo "Travel recorded:    $(travel_recorded_sha)"
      echo "Travel checked out: $(travel_checked_out_sha)"
    else
      echo "Travel submodule: not initialized"
    fi
    ;;
  check-ci-actions)
    python3 "$ROOT/tools/check_ci_actions.py" "$ROOT"
    ;;
  check-core-contracts)
    python3 "$ROOT/scripts/validate-schemas.py"
    ;;
  check-core-reference)
    "$ROOT/scripts/test-reference.sh"
    ;;
  check-travel-revision)
    check_travel_revision
    ;;
  check-travel)
    check_travel_revision
    (cd "$ROOT/domains/travel" && sh tools/tdna check)
    ;;
  check-travel-emulator)
    check_travel_revision
    (cd "$ROOT/domains/travel" && sh tools/tdna check-android-emulator)
    ;;
  check)
    "$0" check-ci-actions
    "$0" check-core-contracts
    "$0" check-core-reference
    "$0" check-travel
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    exit 2
    ;;
esac
